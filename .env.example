# ─────────────────────────────────────────────────────────────────────────────
# .env de la RAÍZ — lo consume docker-compose (env_file) para los servicios
# `api` y `agent`. No reemplaza a server/.env, que se sigue usando cuando
# corrés el backend fuera de Docker (cd server && npm run dev).
#
#   cp .env.example .env
#
# Cero secretos reales acá. Este archivo SÍ se commitea; .env NO.
# ─────────────────────────────────────────────────────────────────────────────

# ── Snapshot de Supabase (solo lo usa scripts/db-snapshot.sh) ───────────────
# Connection string del SESSION POOLER (puerto 5432). El transaction pooler
# (6543) no sirve: pg_dump necesita una sesión real.
# Supabase → Project Settings → Database → Connection string → Session pooler
SUPABASE_DB_URL=

# ── Base de datos ───────────────────────────────────────────────────────────
# docker-compose pisa estas dos para apuntar al Postgres del stack.
DATABASE_URL=postgres://f1:f1@localhost:5432/f1hub
DATABASE_SSL=false

# Tests de integracion del sync. Solo Postgres local: los tests rechazan
# hosts de Supabase y crean/borran un schema aislado.
# docker-compose ya la define para el servicio api.
# TEST_DATABASE_URL=postgres://f1:f1@localhost:5432/f1hub
PG_POOL_MAX=5

# Alternativa a DATABASE_URL (variables sueltas). Sin usar en local.
DB_USER=
DB_HOST=
DB_NAME=
DB_PASSWORD=
DB_PORT=

# ── Servidor ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=dev-secret
ADMIN_PASSWORD=dev-password
# Secreto que usa f1_agent contra GET /api/auth/agent-token.
CRON_SECRET=dev-cron-secret
# Token plano para las rutas admin del newsletter.
ADMIN_API_TOKEN=dev-admin-api-token

# ── f1_agent ────────────────────────────────────────────────────────────────
# docker-compose pisa F1_API_URL con http://api:3000.
F1_API_URL=http://localhost:3000
DRY_RUN=true
MAX_ARTICLES=2

# ─────────────────────────────────────────────────────────────────────────────
# SERVICIOS EXTERNOS — valores dummy.
# El backend arranca igual, pero estas funcionalidades quedan INACTIVAS en local:
#
#   Cloudflare R2  → subida de imágenes de artículos (POST de covers/inline).
#                    Solo se validan como obligatorias con NODE_ENV=production.
#   Gemini/Anthropic → generación de artículos con IA
#                      (/api/articles/admin/generate y generate-bundle).
#   Resend         → envío de mails del newsletter (EMAIL_NOTIFICATIONS_ENABLED=false).
#   Telegram       → notificaciones del workflow de GitHub Actions.
#
# Nada de esto hace falta para el trabajo de datos deportivos.
# ─────────────────────────────────────────────────────────────────────────────

CLOUDFLARE_ACCOUNT_ID=dummy
CLOUDFLARE_R2_BUCKET=dummy
CLOUDFLARE_R2_ACCESS_KEY=dummy
CLOUDFLARE_R2_SECRET_KEY=dummy
CLOUDFLARE_R2_PUBLIC_URL=http://localhost:3000/images

AI_PROVIDER=gemini
AI_MODEL=
GEMINI_API_KEY=dummy
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=dummy

EMAIL_NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=dummy

TELEGRAM_BOT_TOKEN=dummy
TELEGRAM_CHAT_ID=dummy
